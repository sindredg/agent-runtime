# Copy to .env to override the development defaults. .env is never committed.

# Password of the Postgres owner, which runs the migrations.
POSTGRES_PASSWORD=runtime-dev

# Password of runtime_app, the role the API and the worker connect as. The
# migrate service sets it on every start. Both passwords go into URLs: use
# URL-safe characters only.
APP_DATABASE_PASSWORD=runtime-app-dev

# Host port for the API. It is published on 127.0.0.1 only.
API_PORT=8000

# Host port for the fake provider. It is published on 127.0.0.1 only. The
# integration tests read FAKE_PROVIDER_URL; set it too when this changes.
FAKE_PROVIDER_PORT=8001

# Host port for the fake issue tracker. It is published on 127.0.0.1 only.
# The integration tests read FAKE_TRACKER_URL; set it too when this changes.
FAKE_TRACKER_PORT=8002

# Host port for the fake notification receiver. It is published on 127.0.0.1
# only. The integration tests read FAKE_RECEIVER_URL; set it too when this
# changes.
FAKE_RECEIVER_PORT=8003

# Host port for Gitea in the lab demo (`make lab`). It is published on
# 127.0.0.1 only. tests/lab reads LAB_GITEA_PORT from the shell; export it
# too when this changes.
LAB_GITEA_PORT=3000

# Host port for Postgres. It is published on 127.0.0.1 only. The integration
# tests read DATABASE_URL (the owner) and APP_DATABASE_URL (runtime_app); set
# them too when this or a password changes.
POSTGRES_PORT=5432

# The Claude API, read only by `make up-claude`. `make up` and every test
# suite stay on the fake provider while these are set. CLAUDE_MODEL is the
# model for jobs that name none (default claude-haiku-5-5).
# CLAUDE_API_KEY=<your key>
# CLAUDE_MODEL=<a model id>

# Seconds a worker's claim holds a job. When the lease runs out, another
# worker takes the job over.
LEASE_SECONDS=30

# Seconds between two renewals of that lease while a job runs. It has to be
# shorter than LEASE_SECONDS.
HEARTBEAT_SECONDS=10

# The issue tracker the create_issue tool opens issues in. The default is the
# fake tracker of this stack.
# TRACKER_URL=http://fake-tracker:8000

# Seconds a sandboxed tool command (run_shell, list_dir) may run before its
# container is killed. A whole call can take this plus 37 seconds for the
# start and Docker's requests. That and 5 seconds more have to fit in
# STOP_GRACE_SECONDS: the worker refuses to start otherwise.
SANDBOX_TIMEOUT_SECONDS=30

# Seconds a worker gets after SIGTERM to finish a running tool call and hand
# its job back, before Docker kills it.
STOP_GRACE_SECONDS=75

# The group id that owns /var/run/docker.sock. `make` finds it; set it here
# only to run `docker compose` without make.
# DOCKER_GID=
