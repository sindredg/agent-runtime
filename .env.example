# Copy to .env to override the development defaults. .env is never committed.

# Password for the local Postgres container.
POSTGRES_PASSWORD=runtime-dev

# Host port for the API. It is published on 127.0.0.1 only.
API_PORT=8000

# Host port for the fake provider. It is published on 127.0.0.1 only. The
# integration tests read FAKE_PROVIDER_URL; set it too when this changes.
FAKE_PROVIDER_PORT=8001

# Host port for Postgres. It is published on 127.0.0.1 only. The integration
# tests read DATABASE_URL; set it too when this or the password changes.
POSTGRES_PORT=5432

# The model provider the worker calls. The defaults are the fake provider and
# its `hello` scenario. To call the Claude API instead, set all three:
# PROVIDER_BASE_URL=https://api.anthropic.com
# PROVIDER_API_KEY=<your key>
# PROVIDER_MODEL=<a model id>

# Seconds a worker's claim holds a job. When the lease runs out, another
# worker takes the job over.
LEASE_SECONDS=30
